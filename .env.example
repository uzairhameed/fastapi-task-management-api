
# PostgreSQL container configuration
POSTGRES_DB=task_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# FastAPI database connection
DATABASE_URL=postgresql+psycopg://postgres:replace_with_a_strong_database_password@db:5432/task_management_db

# JWT authentication configuration
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
